# Salin ke .env.local lalu sesuaikan. Semua variabel divalidasi di src/config/env.ts.

NEXT_PUBLIC_APP_NAME="Karate Club Management"

# Default "/api" = mock API bawaan (src/app/api). Saat backend (apps/api) sudah punya endpoint
# yang dibutuhkan, ganti ke: NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_API_URL="/api"
