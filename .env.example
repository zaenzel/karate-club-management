# Salin ke .env lalu sesuaikan. Dibaca oleh docker-compose, apps/api, dan packages/db.
# Nilai di bawah hanya untuk development lokal. Jangan dipakai di server sungguhan.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=karate
POSTGRES_PASSWORD=karate_dev_password
POSTGRES_DB=karate_club
# Port host 5433 agar tidak bentrok dengan PostgreSQL lain di laptop (default 5432).
POSTGRES_PORT=5433
DATABASE_URL="postgresql://karate:karate_dev_password@localhost:5433/karate_club?schema=public"

# --- MinIO / S3 (penyimpanan file sertifikat, template, tanda tangan) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=karate-files
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
# S3_FORCE_PATH_STYLE: true untuk MinIO (path style http://endpoint/bucket/key)
S3_FORCE_PATH_STYLE=true
# TTL URL presigned unduhan dalam detik (default 300 detik = 5 menit)
S3_PRESIGN_TTL_SECONDS=300

# --- Redis (antrian render sertifikat apps/worker & BullMQ) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- apps/api ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Auth (JWT, cookies, seed admin) ---
JWT_SECRET="super_secret_jwt_key_karate_club_dev_min_32_chars"
JWT_EXPIRES_IN="8h"
AUTH_COOKIE_NAME="karate_session"
SUPERADMIN_EMAIL="admin@karate.local"
SUPERADMIN_PASSWORD="AdminKarateDev123!"
SUPERADMIN_NAME="Super Admin"

# --- apps/web ---
API_PROXY_TARGET=http://localhost:4000

